# Pflicht
ANTHROPIC_API_KEY=sk-ant-...
# Gemeinsames Geheimnis, das die App als "Authorization: Bearer ..." schickt. Leer = ohne Auth (nur lokal!)
REELCUT_API_TOKEN=change-me

# Optional
REELCUT_CLAUDE_MODEL=claude-opus-5-5
REELCUT_CLAUDE_EFFORT=high          # low|medium|high|xhigh|max
REELCUT_PLANNER=claude              # claude|heuristic (heuristic = ohne API, nur Regeln)
REELCUT_TRANSCRIBER=whisper         # whisper|mock
REELCUT_WHISPER_MODEL=small         # tiny|base|small|medium|large-v3 (small reicht für Deutsch meist aus)
REELCUT_WHISPER_DEVICE=cpu          # cuda für GPU
REELCUT_WHISPER_COMPUTE=int8        # float16 auf GPU
REELCUT_WORK_DIR=./data
REELCUT_MAX_UPLOAD_MB=500
REELCUT_X264_PRESET=medium          # ultrafast für Tests, slow für beste Qualität
REELCUT_X264_CRF=20
# Eigene Schriften (TTF/OTF) in diesem Ordner werden von libass zusätzlich gefunden
# REELCUT_FONTS_DIR=/app/fonts
# REELCUT_FONT_BOLD_SANS=Anton
# REELCUT_FONT_CONDENSED=Bebas Neue
